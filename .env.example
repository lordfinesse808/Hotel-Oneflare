# Copy to .env (never commit .env). Loaded automatically by config/settings.py.
# In CI the same names come from GitHub Actions secrets (TEST_EMAIL, TEST_PASSWORD) and variables.
BASE_URL=https://hotel-plaza-preview.vercel.app

# Existing customer account used by sign-in / account tests (TC-040, TC-105, TC-107).
TEST_EMAIL=you@maildrop.cc
TEST_PASSWORD=change-me
TEST_PHONE=+2348012345678

# true = also run tests that create live records (accounts, bookings, contact messages).
ALLOW_LIVE_WRITES=false

# Performance budgets (ms)
PERF_TTFB_MS=800
PERF_DCL_MS=3000
PERF_LOAD_MS=5000
PERF_LCP_MS=4000
